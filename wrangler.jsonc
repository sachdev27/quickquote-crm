{
  // Nitro merges this with its generated config. Create the DB first:
  //   npx wrangler d1 create tarko-crm   -> paste the database_id below
  "name": "tarko-crm",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tarko-crm",
      "database_id": "9fc7dc48-0d40-4e0d-a1e5-c3008483de64",
      "migrations_dir": "migrations",
    },
  ],
  // Cloudflare Zero Trust > Access > Applications: protect this hostname, then fill these in.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "tarkoindia.cloudflareaccess.com",
    "ACCESS_AUD": "5aba95623b2234798347421438bbee3433825a62ebefb336ea5c2e5e27d24843",
    // Gmail inbox (AI Quote). The client ID is public; GOOGLE_CLIENT_SECRET and GEMINI_API_KEY must be
    // dashboard Secrets (plain variables not listed here are wiped on every deploy).
    "GOOGLE_CLIENT_ID": "1025577054923-cpavvolku40dblragckc2n9cltee3qba.apps.googleusercontent.com",
  },
}
